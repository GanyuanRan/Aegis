    "task-completeness",
    "trace-digest-coverage",
    "rule-effect-attribution",
    "skill-call-stability"
  ],
  "supportingMetrics": [
    "tokens",
    "cost",
    "elapsed-time",
    "diff-size"
  ],
  "coverageSources": {
    "workflowQualityMatrix": "tests/e2e/fixtures/workflow-quality-matrix.json",
